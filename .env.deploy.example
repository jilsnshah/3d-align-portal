# Copy into your host's environment. Nothing here has a safe default.
#
# The free deployment keeps nothing on the container's filesystem, because that
# filesystem is thrown away on every deploy. Two services hold the durable
# state, and both are free:
#
#   Neon      — managed Postgres, does not expire
#   Supabase  — object storage over an S3 API, 1 GB
#
# Render's blueprint (render.yaml) prompts for every value marked sync:false,
# which is this same list.

ENVIRONMENT=production
COOKIE_SECURE=true

# openssl rand -hex 32
# On Render this is generated for you; set it by hand anywhere else.
SECRET_KEY=

# The lab account seeded on first boot. The app refuses to start if this is
# still "changeme", because that password can read every clinic's cases.
STAFF_EMAIL=staff@3dalign.com
STAFF_PASSWORD=

# --------------------------------------------------------------------------
# Database — Neon
# --------------------------------------------------------------------------
# Neon's dashboard gives a psql URL. Change the scheme to postgresql+psycopg,
# keep ?sslmode=require, and prefer the *pooled* host so waking from idle does
# not open a connection per request.
#
#   postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --------------------------------------------------------------------------
# Case files — Supabase Storage (or Cloudflare R2, or Backblaze B2)
# --------------------------------------------------------------------------
STORAGE_BACKEND=s3
# Supabase: Project settings - Storage - S3 connection.
#   https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=
S3_BUCKET=align-files
# Supabase shows this next to the endpoint; it must match the project's region.
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Not case files: the converted 3D meshes, which are derived from the stored
# STLs. On a throwaway filesystem, so losing them costs one slow first view.
STORAGE_LOCAL_ROOT=/tmp/align-cache

# --------------------------------------------------------------------------
# Google Maps
# --------------------------------------------------------------------------
# Server key: Routes + Geocoding + Places. A free container host has no fixed
# egress IP, so restrict this one by API rather than by address.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript only, restricted by HTTP referrer to the
# deployed URL. It is embedded in the page by design.
GOOGLE_MAPS_BROWSER_KEY=

# Same origin serves the app and the API, so this is only needed if they split.
CORS_ORIGINS=https://your-service.onrender.com
