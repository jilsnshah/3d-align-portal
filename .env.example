# Copy to .env at the repo root. Every value here has a working default except
# the ones marked required.

# ---- Core ----------------------------------------------------------------
# SQLite by default so the portal runs with no database to install.
# Postgres:  postgresql+psycopg://align:align@localhost:5432/align
# DATABASE_URL=sqlite:///./backend/dev.db

# REQUIRED in any deployed environment — signs the session cookie.
SECRET_KEY=change-me-to-a-long-random-string

# Set true once you are serving over HTTPS.
COOKIE_SECURE=false

# Where the browser app is served from, for CORS.
CORS_ORIGINS=http://localhost:5173

# ---- The single staff account -------------------------------------------
# Seeded on first boot only. Change the password in the portal afterwards.
STAFF_EMAIL=staff@3dalign.com
STAFF_PASSWORD=changeme

# ---- Case files ----------------------------------------------------------
# "local" writes to backend/storage. "drive" uses a Google service account.
STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=./backend/storage

# For STORAGE_BACKEND=drive: a service-account JSON key, and the ID of a folder
# on a Shared Drive that the service account has been given write access to.
# DRIVE_SERVICE_ACCOUNT_FILE=./secrets/drive-service-account.json
# DRIVE_ROOT_FOLDER_ID=

MAX_UPLOAD_MB=200

# ---- Invoicing (Refrens) -------------------------------------------------
# Leave blank and invoice generation reports that it is not configured.
# NOTE: the previous system had this EC private key committed to git.
# Rotate it in the Refrens dashboard before putting a value here.
# REFRENS_APP_ID=
# REFRENS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# REFRENS_BUSINESS_KEY=3d-align
INVOICE_MODEL_PRINT_FEE=250

# ---- Dental council registry --------------------------------------------
# Scrapes dciindia.gov.in on signup. Advisory only; staff verify manually.
DCI_CHECK_ENABLED=false
